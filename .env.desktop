# Variables de build pour la version DESKTOP (Electron) de BlackTracker.
# Utilisées par `npm run build:desktop` (vite build --mode desktop).
#
# L'app de bureau s'adapte à un serveur local (base SQLite + synchro) : c'est
# la seule vraie différence avec le build web — le code React est identique.
VITE_APP_NAME="BlackTracker"
VITE_APP_ENV=desktop
VITE_USE_MOCK_DATA=false
VITE_API_BASE_URL=http://127.0.0.1:43127/api
VITE_API_TIMEOUT=10000
VITE_AUTH_ENABLED=true
VITE_AUTH_TOKEN_STORAGE_KEY=journal_trading_token
VITE_GOOGLE_CLIENT_ID=1043930347193-pt66pt52o1ukc8fm65f7ih05gkc60uom.apps.googleusercontent.com
VITE_ENABLE_CSV_IMPORT=true
VITE_ENABLE_PDF_EXPORT=true
VITE_DESKTOP=true