# Nom affiché de l'application
VITE_APP_NAME="BlackTracker"

# Environnement courant : development | staging | production
VITE_APP_ENV=development

# Si true, les couches services/api/* lisent les données depuis
# services/mockData/*.json au lieu d'appeler une vraie API HTTP.
# Passer à "false" le jour où un backend réel est branché.
VITE_USE_MOCK_DATA=true

# URL de base de l'API backend (utilisée uniquement si VITE_USE_MOCK_DATA=false)
VITE_API_BASE_URL=http://localhost:8000/api

# Timeout des requêtes HTTP en millisecondes
VITE_API_TIMEOUT=10000

# Active/désactive l'écran de connexion. En mode mock (VITE_USE_MOCK_DATA=true),
# l'authentification email/mot de passe est simulée en localStorage (aucune
# vraie base de données) — pratique pour la démo, à remplacer par un vrai
# backend d'authentification en production.
VITE_AUTH_ENABLED=true

# Clé utilisée pour stocker la session utilisateur (localStorage)
VITE_AUTH_TOKEN_STORAGE_KEY=journal_trading_token

# Client ID OAuth2 Google (Google Identity Services), nécessaire pour activer
# le bouton "Continuer avec Google". À créer sur https://console.cloud.google.com/
# (APIs & Services > Identifiants > Créer des identifiants > ID client OAuth,
# type "Application Web"). Laissez vide pour désactiver le bouton Google.
VITE_GOOGLE_CLIENT_ID=

# Active/désactive la fonctionnalité d'import CSV dans /track-record
VITE_ENABLE_CSV_IMPORT=true

# Active/désactive l'export PDF / impression du track record
VITE_ENABLE_PDF_EXPORT=true

# Réservé pour une future fonctionnalité de coach IA (non implémentée ici)
VITE_ENABLE_AI_COACH=false
